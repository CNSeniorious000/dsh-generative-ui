{
  "name": "dsh-generative-ui",
  "version": "0.0.7",
  "description": "Generative UI for DeepSeek Harness — the agent writes TSX, dsh web renders it live, inline in chat and in a canvas panel",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skill",
    "src",
    "types",
    "cordis.patch.yml",
    "NOTICE"
  ],
  "keywords": [
    "generative-ui",
    "genui",
    "ui4a",
    "artifacts",
    "canvas",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "react",
    "tsx",
    "streaming",
    "ai-agents",
    "llm"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "bun scripts/gen-standalone.ts && bun scripts/build.ts && tsc -p tsconfig.types.json",
    "prepare": "bun scripts/gen-standalone.ts && bun scripts/build.ts && tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/primitives-deps.mjs && bun test",
    "loads": "sh scripts/loads.sh",
    "smoke": "bun scripts/smoke.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:shuffled && bun run audit && bun run replay && bun run cards && bun run paint && bun run build && bun run smoke && bun run loads",
    "check:ci": "bun run lint && bun run typecheck && bun run test && bun run test:shuffled && bun run audit && bun run replay && bun run cards && bun run paint && bun run build && bun run smoke",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "gen:standalone": "bun scripts/gen-standalone.ts",
    "audit": "bun scripts/fresh-rates.ts 2>/dev/null | head -1 > /tmp/fresh-total.txt; python3 scripts/audit-record.py CLAUDE.md && bun scripts/corpus-rates.ts 2>/dev/null | python3 scripts/audit-rates.py",
    "replay": "bun scripts/replay-stream.ts",
    "cards": "bun scripts/compile-cards.ts",
    "paint": "bun scripts/paint-cards.ts",
    "cross-tab": "bun scripts/cross-tab.ts",
    "site": "bun scripts/site.ts",
    "site:dev": "bun scripts/site.ts --dev",
    "inject": "bun scripts/inject.ts",
    "hollow": "bun scripts/hollow.ts",
    "test:shuffled": "sh scripts/test-shuffled.sh"
  },
  "dependencies": {
    "@esm.sh/tsx": "^1.5.3",
    "@unocss/core": "^66.8.1",
    "@unocss/preset-wind4": "^66.8.1",
    "partial-react": "~0.0.8",
    "partial-tsx": "~0.0.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2 || ^4.0.5-0",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.1 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.1 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-rc.1 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.5-rc.1 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.1 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-skill": "^0.1.5-rc.1 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/schemastery": "^3.18.2 || ^3.18.5-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-native-command": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-title": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-workspace": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@shikijs/langs": "^4.4.3",
    "@types/node": "^26.3.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "@types/scheduler": "^0.26.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "immer": "^10.1.1",
    "katex": "^0.19.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromatch": "^4.0.8",
    "minimatch": "^10.2.6",
    "motion": "^13.1.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.80.0",
    "picomatch": "^4.0.7",
    "pkg-pr-new": "^0.0.88",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.4.3",
    "simple-icons": "^16.33.0",
    "typescript": "^7.0.2",
    "zustand": "~4.4.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MindLab-Research/dsh-generative-ui.git"
  },
  "homepage": "https://github.com/MindLab-Research/dsh-generative-ui#readme",
  "bugs": "https://github.com/MindLab-Research/dsh-generative-ui/issues",
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
